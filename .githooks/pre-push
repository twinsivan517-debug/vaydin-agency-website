#!/bin/sh
# Armed by `npm install` (the prepare script points git at this folder).
# Since 2026-11-09 the ship gate runs on a GitHub runner (pages.yml, scripts/runner-gate.mjs). What stays on
# the laptop is the one check that must happen BEFORE the bytes reach the public repo: no key, no secret file.
# It scans the files tracked in the checked-out tree, not the commits being pushed.
exec node scripts/secret-scan.mjs
